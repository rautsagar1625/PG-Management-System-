# Production environment template — copy to .env on your server, fill in real values.
# NEVER commit the actual .env file.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=pguser
POSTGRES_PASSWORD=<generate: openssl rand -hex 32>
POSTGRES_DB=pg_system

# ── Prisma Database URL ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pguser:<password>@postgres:5432/pg_system?schema=public&connection_limit=20&pool_timeout=10

# ── JWT Secrets ────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 64
JWT_SECRET=<generate>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<generate>
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://app.yourdomain.com

# ── API URL (baked into Next.js browser bundle at Docker build time) ───────────
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Runtime ────────────────────────────────────────────────────────────────────
PORT=3001
API_PREFIX=api/v1
NODE_ENV=production
