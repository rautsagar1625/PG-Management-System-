// PG Management System — Production Schema
// PostgreSQL + Prisma 5.x
//
// Migration note: run `pnpm db:migrate` after any schema change.
// Never use Float for money — all monetary fields use Decimal(10,2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  phone          String?    @unique
  whatsappPhone  String?    // May differ from phone; used for WhatsApp messages
  passwordHash   String
  systemRole     SystemRole @default(USER)
  isVerified     Boolean    @default(false)
  isActive       Boolean    @default(true)
  lastLoginAt    DateTime?
  expoPushToken  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  propertyRoles      PropertyRole[]
  tenantProfile      Tenant?
  sessions           Session[]
  passwordResets     PasswordReset[]
  deviceTokens       DeviceToken[]     // MA-001: push notification tokens per device
  notifications      Notification[]
  auditLogs          AuditLog[]
  complaintsRaised   Complaint[]       @relation("ComplaintRaisedBy")
  complaintsAssigned Complaint[]       @relation("ComplaintAssignedTo")
  complaintUpdates   ComplaintUpdate[]
  paymentsRecorded   Payment[]         @relation("PaymentRecordedBy")
  fileUploads        FileUpload[]
  operationalNotes   OperationalNote[]
  leadsCreated       Lead[]            @relation("LeadCreatedBy")
  leadsAssigned      Lead[]            @relation("LeadAssignedTo")
  attendanceRecords  AttendanceRecord[]

  @@index([email])
  @@index([phone])
}

// Tracks active refresh tokens. One session = one device login.
model Session {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  // RB-005: token family tracking — all rotated tokens from the same login share a
  // familyId. If a stolen (already-revoked) refresh token is replayed, we detect
  // it by the REVOKED status of the matching session record and revoke every session
  // in the same family, forcing the attacker and legitimate user to re-authenticate.
  familyId  String    // cuid — set at login/register, inherited by rotated tokens
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([familyId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  // NS-004: track email delivery outcome.
  // If SMTP fails, the reset token exists in the DB but the user never receives the link.
  // Support staff can detect this and resend, or escalate to check SMTP health.
  emailSentAt   DateTime? // set when sendPasswordReset() succeeds
  emailFailedAt DateTime? // set when sendPasswordReset() throws
  emailError    String?   // first 500 chars of the error message
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// MA-001 fix: Stores FCM (Android) and APNs (iOS) push notification tokens so
// that the notification service can deliver rent reminders, complaint updates,
// and move-out alerts to mobile devices. Previously there was no DeviceToken
// model, making the entire mobile push notification system non-functional.
//
// Register token on mobile login; invalidate (delete) on logout.
// token is unique — if FCM rotates a token, the old entry is replaced.
model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  token     String         @unique  // FCM registration token or APNs device token
  platform  DevicePlatform
  appVersion String?       // Client app version for debugging push failures
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum SystemRole {
  SUPER_ADMIN
  USER
}

// ─────────────────────────────────────────
// PROPERTY
// ─────────────────────────────────────────

model Property {
  id            String         @id @default(cuid())
  name          String
  slug          String?        @unique // URL-friendly identifier for public page
  description   String?        // Public-facing description
  address       String
  city          String
  state         String
  pincode       String
  type          PropertyType   @default(MIXED)
  status        PropertyStatus @default(SETUP)
  amenities     String[]       @default([])
  rules         String[]       @default([])
  heroImageUrl  String?        // Main photo for public listing
  contactPhone  String?        // Public inquiry contact
  isPublicListed Boolean       @default(false) // Show on public /p/[slug] page
  wifiSSIDs     String[]       @default([])    // Registered WiFi SSIDs for attendance
  attendanceRadius Int         @default(200)   // GPS geofence radius in meters

  // BM-004: GST compliance — applicable in states where PG rent > ₹7,500/month
  // falls under GST. Zero-defaulted; enterprise clients opt in.
  gstApplicable Boolean @default(false)
  gstNumber     String? // GSTIN of the property owner/operator
  gstRate       Decimal @default(0) @db.Decimal(5, 2) // e.g. 18.00 for 18%

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  roles            PropertyRole[]
  rooms            Room[]
  tenants          Tenant[]
  financialModels  FinancialModel[]
  settlements      Settlement[]
  complaints       Complaint[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  rentCycles       RentCycle[]
  payments         Payment[]
  operationalNotes OperationalNote[]
  leads            Lead[]
  foodMenus        FoodMenu[]
  attendanceRecords AttendanceRecord[]
  autoPayMandates   AutopayMandate[]
  agreements        RentalAgreement[]

  @@index([city])
  @@index([status])
  @@index([slug])
}

// One role per user per property. Change role = update existing record.
model PropertyRole {
  id         String           @id @default(cuid())
  propertyId String
  userId     String
  role       PropertyRoleType
  addedBy    String?          // userId of who assigned this
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([propertyId])
  @@index([userId])
}

enum PropertyType {
  MALE
  FEMALE
  MIXED
}

enum PropertyStatus {
  SETUP              // Being configured — not yet live
  ACTIVE             // Fully operational
  UNDER_MAINTENANCE  // Temporarily suspended (repairs, renovations)
  INACTIVE           // Paused — no new admissions
  CLOSED             // Permanently shut down
}

enum PropertyRoleType {
  OWNER       // Owns the building; receives payout
  OPERATOR    // Runs day-to-day operations
  CO_OPERATOR // Operations partner; has defined profit share
  STAFF       // Support (warden, caretaker) — limited permissions
}

// ─────────────────────────────────────────
// ROOMS & BEDS
// ─────────────────────────────────────────

model Room {
  id               String     @id @default(cuid())
  propertyId       String
  number           String     // Display identifier: "101", "G-2", "A1"
  floor            Int?       // Numeric floor (0 = ground, 1 = first, etc.)
  floorLabel       String?    // Human label: "Ground Floor", "1st Floor"
  type             RoomType
  sharingCapacity  Int        // Max occupants: 1, 2, 3, 4, 6
  baseRent         Decimal    @db.Decimal(10, 2) // Listed/standard rent per bed for this room
  status           RoomStatus @default(AVAILABLE)
  amenities        String[]   @default([])
  // Physical attributes
  attachedWashroom Boolean    @default(false)
  acAvailable      Boolean    @default(false)
  balcony          Boolean    @default(false)
  genderType       PropertyType? // Override property gender type at room level
  // Operational
  maintenanceNote  String?    // Brief note when status = UNDER_MAINTENANCE
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  beds     Bed[]

  @@unique([propertyId, number])
  @@index([propertyId, status])
  @@index([propertyId, floor])
}

model Bed {
  id          String    @id @default(cuid())
  roomId      String
  label       String    // "A", "B", "C" within a room
  monthlyRent Decimal?  @db.Decimal(10, 2) // Overrides room rent when set
  status      BedStatus @default(AVAILABLE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  room        Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations TenantAllocation[]

  @@unique([roomId, label])
  @@index([roomId, status])
}

enum RoomType {
  PRIVATE        // 1 occupant
  DOUBLE_SHARING // 2 occupants
  TRIPLE_SHARING // 3 occupants
  FOUR_SHARING   // 4 occupants
  SIX_SHARING    // 6 occupants
}

enum RoomStatus {
  AVAILABLE
  PARTIALLY_OCCUPIED
  FULLY_OCCUPIED
  UNDER_MAINTENANCE
  INACTIVE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED          // Locked for a tenant in ROOM_FINALIZED / PENDING_COMPLIANCE state
  UNDER_MAINTENANCE // Temporarily out of service for repairs
  BLOCKED           // Admin-blocked; not available for allocation (e.g. removed bed)
}

// ─────────────────────────────────────────
// TENANT SYSTEM
// ─────────────────────────────────────────

model Tenant {
  id             String        @id @default(cuid())
  userId         String        @unique
  propertyId     String
  tenantCode     String        @unique // Format: PG-XXXXX
  status         TenantStatus  @default(LEAD)
  kycStatus      KycStatus     @default(PENDING)
  leadSource     String?
  notes          String?

  // Deposit tracking
  depositAmount  Decimal       @default(0) @db.Decimal(10, 2) // Required deposit
  depositBalance Decimal       @default(0) @db.Decimal(10, 2) // Amount paid to date
  depositStatus  DepositStatus @default(PENDING)

  // Compliance flags — tracked independently so any order is valid
  depositCompleted  Boolean @default(false) // Deposit fully paid
  kycCompleted      Boolean @default(false) // KYC docs submitted & verified
  agreementSigned   Boolean @default(false) // Rental agreement executed

  // Lifecycle timestamps
  visitScheduledAt DateTime?
  visitedAt        DateTime?
  moveInDate       DateTime?
  moveOutDate      DateTime?
  noticeDate       DateTime?
  archivedAt       DateTime?
  // SP4-6: DPDP-lite — records when PII was scrubbed. Non-null means this record
  // has been anonymised and direct PII (User.name, User.phone, document numbers,
  // emergency contacts) has been redacted.
  anonymisedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  property          Property           @relation(fields: [propertyId], references: [id])
  allocations       TenantAllocation[]
  documents         TenantDocument[]
  emergencyContacts EmergencyContact[]
  rentCycles        RentCycle[]
  payments          Payment[]
  receipts          Receipt[]
  complaints        Complaint[]
  autoPayMandates   AutopayMandate[]
  agreements        RentalAgreement[]
  lead              Lead?              @relation("TenantFromLead")

  @@index([propertyId, status])
  @@index([tenantCode])
}

// ──────────────────────────────────────────────────────────────
// TENANT ALLOCATION — the heart of the occupancy system
//
// Every bed occupancy event (move-in, transfer, move-out) is
// represented here. History is NEVER deleted — only closed.
//
// Rules:
//  • A tenant can have at most ONE active allocation (isActive=true)
//  • A bed can have at most ONE active allocation
//  • These are enforced at the service layer with transactions
// ──────────────────────────────────────────────────────────────
model TenantAllocation {
  id          String           @id @default(cuid())
  tenantId    String
  bedId       String
  startDate   DateTime
  endDate     DateTime?        // null = currently active
  isActive    Boolean          @default(true)
  monthlyRent Decimal          @db.Decimal(10, 2) // Rent locked at allocation time
  reason         AllocationReason @default(INITIAL)
  transferReason TransferReason?  // Set only when reason = TRANSFER
  notes          String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bed    Bed    @relation(fields: [bedId], references: [id])

  @@index([tenantId, isActive])
  @@index([bedId, isActive])
}

enum AllocationReason {
  INITIAL  // First move-in
  TRANSFER // Moved from a different bed
}

enum TransferReason {
  TENANT_REQUEST    // Tenant asked to change room
  UPGRADE           // Moving to better/larger room
  DOWNGRADE         // Moving to smaller/cheaper room
  MAINTENANCE       // Current room under maintenance
  ROOMMATE_CONFLICT // Conflict with existing roommates
  OPERATOR_DECISION // Operator reorganising occupancy
  OTHER             // Reason noted in notes field
}

// KYC documents — one row per document submitted
model TenantDocument {
  id             String       @id @default(cuid())
  tenantId       String
  type           DocumentType
  documentNumber String
  fileUrl        String?
  verifiedAt     DateTime?
  verifiedBy     String?      // userId
  createdAt      DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model EmergencyContact {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String
  relation  String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

enum TenantStatus {
  LEAD
  VISIT_SCHEDULED
  VISITED
  ROOM_FINALIZED
  PENDING_COMPLIANCE  // Deposit + KYC + agreement tracked independently via boolean flags
  DEPOSIT_PENDING     // @deprecated — use PENDING_COMPLIANCE + depositCompleted=false
  KYC_PENDING         // @deprecated — use PENDING_COMPLIANCE + kycCompleted=false
  ACTIVE
  NOTICE_PERIOD
  MOVED_OUT
  ARCHIVED            // Soft-archived post move-out; excluded from operational lists
  REJECTED
}

enum KycStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum DepositStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
  FORFEITED
}

enum DocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
}

// ─────────────────────────────────────────
// FINANCIAL MODELS & SETTLEMENTS
// ─────────────────────────────────────────

// Defines how revenue is split between owner and operator.
// A property has exactly ONE active model. Changing the model
// creates a new record; the old one gets effectiveTo set.
model FinancialModel {
  id                   String             @id @default(cuid())
  propertyId           String
  type                 FinancialModelType
  fixedOwnerPayout     Decimal?           @db.Decimal(10, 2) // FIXED_PAYOUT only
  ownerSharePercent    Decimal?           @db.Decimal(5, 2)  // REVENUE_SHARE only
  operatorSharePercent Decimal?           @db.Decimal(5, 2)  // REVENUE_SHARE only
  // BM-004: deposit interest — some PGs credit tenants with interest on deposit
  // held > 12 months. Zero-default; opt-in per financial model.
  depositInterestRate  Decimal            @default(0) @db.Decimal(5, 2) // annual %, e.g. 6.00
  isActive             Boolean            @default(true)
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  createdBy            String             // userId
  createdAt            DateTime           @default(now())

  property    Property     @relation(fields: [propertyId], references: [id])
  settlements Settlement[]

  @@index([propertyId, isActive])
  // SP5-3: settlement period query: WHERE effectiveFrom <= X ORDER BY effectiveFrom DESC
  @@index([propertyId, effectiveFrom])
}

model RentCycle {
  id              String          @id @default(cuid())
  tenantId        String
  propertyId      String
  month           Int
  year            Int
  dueDate         DateTime
  rentAmount      Decimal         @db.Decimal(10, 2)
  paidAmount      Decimal         @default(0) @db.Decimal(10, 2)
  remainingAmount Decimal         @db.Decimal(10, 2) // rentAmount - paidAmount, never < 0
  lateFee         Decimal         @default(0) @db.Decimal(10, 2)
  status          RentCycleStatus @default(PENDING)
  waivedBy        String?
  waivedAt        DateTime?
  waivedReason    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  property Property  @relation(fields: [propertyId], references: [id])
  payments Payment[]

  @@unique([tenantId, month, year])
  @@index([propertyId, month, year])
  @@index([tenantId, status])
  @@index([status, dueDate])
  @@index([dueDate])
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  propertyId  String
  rentCycleId String?       // null for deposit/misc payments
  amount      Decimal       @db.Decimal(10, 2)
  type        PaymentType
  method      PaymentMethod
  referenceNo String?       // UTR number, cheque number, etc.
  notes       String?
  recordedBy  String        // userId of operator who recorded it
  paidAt      DateTime      // When money was actually received
  createdAt   DateTime      @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  property  Property   @relation(fields: [propertyId], references: [id])
  rentCycle RentCycle? @relation(fields: [rentCycleId], references: [id])
  recorder  User       @relation("PaymentRecordedBy", fields: [recordedBy], references: [id])
  receipt   Receipt?

  @@index([tenantId])
  @@index([tenantId, paidAt])      // PF-003: rent history queries sorted by date (was full scan)
  @@index([propertyId, type, paidAt])
  @@index([rentCycleId])
  @@index([referenceNo])
}

// Immutable once created. Receipt number is the human-readable reference.
model Receipt {
  id        String   @id @default(cuid())
  receiptNo String   @unique // RCP-YYYYMM-XXXXX
  paymentId String   @unique
  tenantId  String
  issuedAt  DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([receiptNo])
}

// Monthly owner-operator reconciliation
model Settlement {
  id               String           @id @default(cuid())
  propertyId       String
  financialModelId String
  month            Int
  year             Int
  totalCollected   Decimal          @db.Decimal(10, 2)
  ownerPayout      Decimal          @db.Decimal(10, 2)
  operatorProfit   Decimal          @db.Decimal(10, 2)
  breakdown        Json             // Full audit trail of calculation inputs
  status           SettlementStatus @default(CALCULATED)
  settledBy        String?          // userId who marked it paid
  settledAt        DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  property       Property       @relation(fields: [propertyId], references: [id])
  financialModel FinancialModel @relation(fields: [financialModelId], references: [id])

  @@unique([propertyId, month, year])
  @@index([propertyId, status])
}

enum FinancialModelType {
  FIXED_PAYOUT   // Operator pays owner a fixed amount; keeps the rest
  REVENUE_SHARE  // Revenue split by percentages
  OWNER_OPERATED // Owner runs it themselves — no split
}

enum RentCycleStatus {
  PENDING  // Created, due date not yet reached
  DUE      // Due date reached
  PARTIAL  // Partially paid, within grace period
  PAID     // Fully paid
  OVERDUE  // Past grace period, not fully paid
  WAIVED   // Written off
}

enum PaymentType {
  RENT
  DEPOSIT
  DEPOSIT_REFUND
  DEPOSIT_ADJUSTMENT // Security deposit applied to cover unpaid rent
  RENT_REFUND        // Overpayment or pro-rata refund on rent
  ADJUSTMENT         // Generic credit/debit correction (with notes)
  WAIVER             // Formal write-off of an outstanding amount
  FINE
  MISCELLANEOUS
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  ONLINE
}

enum SettlementStatus {
  CALCULATED // Amounts computed, pending owner confirmation
  PAID       // Owner confirmed receipt
  DISPUTED   // Under review
}

// ─────────────────────────────────────────
// COMPLAINTS
// ─────────────────────────────────────────

model Complaint {
  id          String            @id @default(cuid())
  propertyId  String
  tenantId    String?
  raisedBy    String
  assignedTo  String?
  category    ComplaintCategory
  title       String
  description String
  priority    Priority          @default(MEDIUM)
  status      ComplaintStatus   @default(OPEN)
  resolvedAt  DateTime?
  reopenedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  property       Property         @relation(fields: [propertyId], references: [id])
  tenant         Tenant?          @relation(fields: [tenantId], references: [id])
  raisedByUser   User             @relation("ComplaintRaisedBy", fields: [raisedBy], references: [id])
  assignedToUser User?            @relation("ComplaintAssignedTo", fields: [assignedTo], references: [id])
  updates        ComplaintUpdate[]

  @@index([propertyId, status])
  @@index([tenantId])
  @@index([assignedTo, status])
}

// Thread of updates on a complaint — status changes, comments, assignments
model ComplaintUpdate {
  id           String   @id @default(cuid())
  complaintId  String
  updatedBy    String
  comment      String
  statusChange String?  // Human-readable: "OPEN → ASSIGNED"
  createdAt    DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [updatedBy], references: [id])

  @@index([complaintId])
}

enum ComplaintCategory {
  MAINTENANCE
  PLUMBING
  ELECTRICAL
  HOUSEKEEPING
  SECURITY
  FOOD
  WIFI
  NOISE
  OTHER
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REOPENED    // Tenant contested resolution — restarts the workflow
  CLOSED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─────────────────────────────────────────
// AUDIT & NOTIFICATIONS
// ─────────────────────────────────────────

// Immutable audit trail — captures before/after state for all sensitive operations
model AuditLog {
  id         String   @id @default(cuid())
  propertyId String?
  userId     String?  // Who triggered the action
  entity     String   // "Tenant" | "Payment" | "TenantAllocation" | etc.
  entityId   String   // ID of the affected record
  action     String   // "MOVE_IN" | "PAYMENT_RECORDED" | "STATUS_CHANGED" | etc.
  before     Json?    // State before change
  after      Json?    // State after change
  metadata   Json?    // Additional context (IP, userAgent, etc.)
  createdAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([entityId, entity])
  @@index([propertyId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  propertyId String?
  type       NotificationType
  title      String
  body       String
  data       Json?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

enum NotificationType {
  RENT_DUE
  RENT_OVERDUE
  PAYMENT_RECEIVED
  MOVE_IN_CONFIRMED
  MOVE_OUT_INITIATED
  COMPLAINT_ASSIGNED
  COMPLAINT_RESOLVED
  ANNOUNCEMENT
  SYSTEM
  LEAD_ASSIGNED
  AUTOPAY_ACTIVATED
  AUTOPAY_DEBIT
  AGREEMENT_READY
  AGREEMENT_SIGNED
  ATTENDANCE_REMINDER
}

// ─────────────────────────────────────────
// FILE STORAGE
// ─────────────────────────────────────────

// Tracks every file uploaded through the platform.
// Files are stored in S3/R2; this table holds metadata + access control.
// Upload flow: request presigned URL → browser uploads directly → confirm upload.
model FileUpload {
  id         String         @id @default(cuid())
  key        String         @unique // S3/R2 object key
  bucket     String
  fileName   String         // Sanitized original filename (no path, no special chars)
  mimeType   String
  sizeBytes  Int?           // Filled in on confirm
  entityType FileEntityType
  entityId   String         // ID of related entity (tenantId, complaintId, etc.)
  uploadedBy String         // userId
  status     FileStatus     @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  uploader User @relation(fields: [uploadedBy], references: [id])

  @@index([entityType, entityId])
  @@index([uploadedBy])
  @@index([status, createdAt])
}

enum FileEntityType {
  TENANT_KYC      // Aadhaar, PAN, passport
  COMPLAINT_IMAGE // Photos attached to complaints
  AGREEMENT       // Rental agreement documents
  RECEIPT_PDF     // Generated receipt PDFs
  TENANT_PHOTO    // Tenant profile photo
  OTHER
}

enum FileStatus {
  PENDING  // Presigned URL issued; file not yet uploaded
  UPLOADED // Confirmed present in storage
  FAILED   // Upload expired or failed
  DELETED  // Soft-deleted; key retained for audit trail
}

// ─────────────────────────────────────────
// OPERATIONAL NOTES
// ─────────────────────────────────────────

// Freeform operational notes — not complaints, not audit logs.
// Examples: "Promised payment on 15th", "Mattress replaced", "Late fee waived".
// Can be attached to any entity or left as general property-level notes.
// entityType + entityId form a polymorphic reference (no FK enforced — by design).
// Application layer is responsible for ensuring entityId is valid for its entityType.
model OperationalNote {
  id         String         @id @default(cuid())
  propertyId String
  entityType NoteEntityType
  entityId   String?        // Polymorphic: tenantId, roomId, complaintId, etc.
  content    String
  isPinned   Boolean        @default(false)
  createdBy  String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [createdBy], references: [id])

  @@index([propertyId, entityType, entityId])
  @@index([propertyId, isPinned, createdAt])
  @@index([entityType, entityId])
}

enum NoteEntityType {
  TENANT
  ROOM
  COMPLAINT
  PROPERTY
  GENERAL
}

// ─────────────────────────────────────────
// LEAD CRM
// ─────────────────────────────────────────

model Lead {
  id          String     @id @default(cuid())
  propertyId  String
  name        String
  phone       String
  email       String?
  source      LeadSource @default(DIRECT)
  status      LeadStatus @default(NEW)
  budget      Decimal?   @db.Decimal(10, 2)
  moveInDate  DateTime?
  roomType    RoomType?
  notes       String?
  assignedTo  String?    // userId of staff
  visitDate   DateTime?
  tokenAmount Decimal?   @db.Decimal(10, 2) // Booking token paid
  convertedAt DateTime?  // When lead became a Tenant
  tenantId    String?    @unique            // Set on conversion
  createdBy   String     // userId
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  assignedUser User?    @relation("LeadAssignedTo", fields: [assignedTo], references: [id])
  creator      User     @relation("LeadCreatedBy", fields: [createdBy], references: [id])
  tenant       Tenant?  @relation("TenantFromLead", fields: [tenantId], references: [id])

  @@index([propertyId, status])
  @@index([phone])
  @@index([createdAt])
  // SP5-6: "My leads" / team-assignment filter — common CRM query pattern
  @@index([propertyId, assignedTo])
}

enum LeadSource {
  DIRECT
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  BROKER
  WALK_IN
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  VISITED
  NEGOTIATING
  TOKEN_PAID
  CONVERTED // Tenant record created
  LOST
}

// ─────────────────────────────────────────
// FOOD MENU
// ─────────────────────────────────────────

model FoodMenu {
  id         String   @id @default(cuid())
  propertyId String
  dayOfWeek  Int      // 0=Sunday … 6=Saturday
  mealType   MealType
  items      String[]
  timing     String?  // "7:30 AM – 9:00 AM"
  isActive   Boolean  @default(true)
  createdBy  String   // userId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, dayOfWeek, mealType])
  @@index([propertyId, isActive])
}

enum MealType {
  BREAKFAST
  LUNCH
  EVENING_SNACK
  DINNER
}

// ─────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────

model AttendanceRecord {
  id         String         @id @default(cuid())
  userId     String
  propertyId String
  type       AttendanceType
  latitude   Float?
  longitude  Float?
  accuracy   Float?         // GPS accuracy in metres
  wifiSSID   String?        // WiFi network detected at check-in
  isValid    Boolean        @default(true)
  invalidReason String?     // Populated when isValid=false
  deviceInfo String?
  createdAt  DateTime       @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([propertyId, createdAt])
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

// ─────────────────────────────────────────
// AUTOPAY MANDATE
// ─────────────────────────────────────────

model AutopayMandate {
  id            String        @id @default(cuid())
  tenantId      String
  propertyId    String
  externalId    String?       // Razorpay mandate ID
  amount        Decimal       @db.Decimal(10, 2)
  bankAccount   String?       // Masked: XXXX1234
  ifscCode      String?
  accountName   String?
  debitDay      Int           @default(1) // Day of month to auto-debit (1–28)
  status        MandateStatus @default(CREATED)
  activatedAt   DateTime?
  cancelledAt   DateTime?
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id])

  @@index([tenantId])
  @@index([propertyId, status])
}

enum MandateStatus {
  CREATED  // Initiation sent to tenant
  PENDING  // Waiting for bank approval
  ACTIVE   // Approved, auto-debit enabled
  PAUSED   // Temporarily suspended
  CANCELLED
  EXPIRED
  FAILED
}

// ─────────────────────────────────────────
// RENTAL AGREEMENTS
// ─────────────────────────────────────────

model RentalAgreement {
  id             String          @id @default(cuid())
  tenantId       String
  propertyId     String
  allocationId   String?
  terms          String          // Agreement body text
  rentAmount     Decimal         @db.Decimal(10, 2)
  depositAmount  Decimal         @db.Decimal(10, 2)
  startDate      DateTime
  endDate        DateTime?
  status         AgreementStatus @default(DRAFT)
  signedByTenantAt DateTime?
  signedByOwnerAt  DateTime?
  fileUrl        String?         // Generated PDF stored in S3/R2
  createdBy      String          // userId
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id])

  @@index([tenantId])
  @@index([propertyId, status])
}

enum AgreementStatus {
  DRAFT
  SENT       // Sent to tenant for signing
  SIGNED     // Both parties signed
  EXPIRED
  CANCELLED
}
