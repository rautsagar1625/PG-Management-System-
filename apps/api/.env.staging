# ─────────────────────────────────────────────────────────────────────────────
# PG Management System — Staging Environment
# Copy and fill ALL values before deploying. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=staging
PORT=3001
API_PREFIX=api/v1
APP_URL=https://your-web-domain.com        # ← fill: your staging web URL

# ── Database (managed Postgres) ───────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pg_system_staging?schema=public&sslmode=require"

# ── Redis (managed Redis / Railway / Upstash) ─────────────────────────────────
REDIS_HOST=your-redis-host                 # ← fill
REDIS_PORT=6379
# REDIS_URL=redis://:password@host:6379    # Alternative: full URL form

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://your-web-domain.com   # ← fill: comma-sep if multiple

# ── JWT — generate with: openssl rand -hex 64 ────────────────────────────────
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_HEX"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_HEX"
JWT_REFRESH_EXPIRES_IN=7d

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Email — Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX     # ← fill: https://resend.com/api-keys
EMAIL_FROM="PG Manager <noreply@your-domain.com>"

# ── WhatsApp — Twilio ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX   # ← fill
TWILIO_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX      # ← fill
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886              # ← fill: your Twilio number

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX     # ← use TEST keys for staging
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_PLAN_ID=plan_XXXXXXXXXXXX

# ── S3-compatible Storage (Cloudflare R2 recommended) ────────────────────────
S3_BUCKET=pg-system-staging
S3_REGION=auto                            # R2: auto | AWS: ap-south-1
S3_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX     # ← fill
S3_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com  # ← fill for R2

# ── Monitoring — Sentry ───────────────────────────────────────────────────────
SENTRY_DSN=https://KEY@ORGID.ingest.sentry.io/PROJECT_ID  # ← fill
