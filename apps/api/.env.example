# ─────────────────────────────────────────────────────────────────────────────
# PG Management System — API Environment Variables
# Copy this file to .env and fill in all values before running the API.
# Never commit your actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/pg_system_dev?schema=public"

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development                          # development | staging | production
PORT=3001
API_PREFIX=api/v1
APP_URL=http://localhost:3000                 # Public URL of the web frontend (used in emails)

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── JWT (generate secrets with: openssl rand -hex 64) ────────────────────────
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-to-another-strong-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60          # Window in seconds
THROTTLE_LIMIT=100       # Max requests per window per IP

# ── Redis (required for BullMQ job queues + caching) ─────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:password@redis-host:6379          # with auth
# REDIS_URL=rediss://user:password@redis-host:6380     # TLS

# ── Email — Resend (https://resend.com) ───────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="PG Manager <noreply@yourdomain.com>"

# ── SMS / WhatsApp — Twilio ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Razorpay (online payments + e-NACH autopay) ───────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxx          # Autopay subscription plan ID

# ── S3-compatible File Storage ────────────────────────────────────────────────
# Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2, etc.
S3_BUCKET=pg-system-uploads
S3_REGION=ap-south-1                        # AWS: ap-south-1, R2: auto
S3_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com  # Only needed for non-AWS providers

# ── Monitoring — Sentry ───────────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/xxx      # Leave commented to disable error tracking
