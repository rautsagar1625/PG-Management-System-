# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/pg_system_dev?schema=public"

# JWT
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-to-another-strong-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
