# ── Web App Environment Variables ─────────────────────────────────────────────
# Copy to .env.local for local development
# Set these in your deployment platform (Vercel / Render / Docker) for production

# API base URL — no trailing slash
# Local:      http://localhost:3001/api/v1
# Production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# JWT secret — must match API's JWT_SECRET exactly (used for edge middleware session verification)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Sentry (optional — leave unset to disable error tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@o000000.ingest.sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=pg-management-web
