# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=pguser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=pg_system

# ── Prisma Database URL ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pguser:change_me_strong_password@localhost:5432/pg_system?schema=public

# ── JWT Secrets (generate with: openssl rand -hex 64) ──────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_min_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS (browser origin that talks to the API) ────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Web → API URL (baked into browser JS at build time) ───────────────────────
# Local dev: http://localhost:3001/api/v1
# Production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── Redis (BullMQ job queues) ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── API runtime ────────────────────────────────────────────────────────────────
PORT=3001
API_PREFIX=api/v1
NODE_ENV=development
